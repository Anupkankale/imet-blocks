{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "imet/cta",
  "title": "IMET Call to Action",
  "category": "imet",
  "icon": "button",
  "description": "Rounded deep-blue CTA card with heading, text, button and photo.",
  "keywords": [
    "imet",
    "section"
  ],
  "version": "1.0.0",
  "textdomain": "imet-blocks",
  "supports": {
    "anchor": true,
    "html": false
  },
  "imet": {
    "tagName": "section",
    "className": "cta-wrap",
    "anchor": ""
  },
  "editorScript": "file:./index.js",
  "style": [
    "imet-base",
    "file:./style-index.css"
  ],
  "styles": [
    {
      "name": "default",
      "label": "Default",
      "isDefault": true
    },
    {
      "name": "compact",
      "label": "Compact"
    }
  ]
}
{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "imet/testimonials",
	"title": "IMET Testimonials",
	"category": "imet",
	"icon": "format-quote",
	"description": "Header, quote cards with a LinkedIn link, and a View More link. Duplicate a card to add one; set each LinkedIn link to the person's profile.",
	"keywords": [
		"imet",
		"section",
		"testimonials",
		"reviews",
		"clients"
	],
	"version": "1.0.0",
	"textdomain": "imet-blocks",
	"supports": {
		"anchor": true,
		"html": false
	},
	"imet": {
		"tagName": "section",
		"className": "section testimonials",
		"anchor": ""
	},
	"editorScript": "file:./index.js",
	"style": [
		"imet-base",
		"file:./style-index.css"
	],
	"viewScript": "file:./view.js",
	"styles": [
		{
			"name": "default",
			"label": "Default",
			"isDefault": true
		},
		{
			"name": "compact",
			"label": "Compact"
		}
	]
}
